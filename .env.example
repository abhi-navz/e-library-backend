# Server
PORT=3000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/e-library

# Authentication (replace with a long, random secret in your local .env file)
JWT_SECRET=a_long_random_secret_string

# Initial administrator bootstrap (replace locally; never commit real credentials)
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace_with_a_strong_password

# AI summary service (UserFacet AI)
AI_API_TOKEN=your_userfacet_ai_token
AI_API_BASE_URL=https://ai-api.userfacet.com
